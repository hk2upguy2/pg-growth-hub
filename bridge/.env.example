# Copy to .env on the Sage server. NEVER commit .env or put the service key in the app.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=paste-the-service_role-key-here
# folder that the Visual Integrator import job reads (CRM orders arrive here as pg-orders-<time>.csv)
SAGE_ORDERS_OUT=C:\PGLink\orders-out
# Option A: read Sage directly (recommended). ODBC DSN for Sage 100 and a READ-ONLY Sage user
SAGE_DSN=SOTAMAS90
SAGE_USER=pglink
SAGE_PASSWORD=
# Option B (no ODBC): a folder where the Invoice Listing and Open Sales Order Listing are saved as .xlsx
# SAGE_LISTINGS_IN=C:\PGLink\listings-in
SAGE_WAREHOUSE=000
# CRM rep name -> Sage salesperson code, e.g. {"Maria Cruz":"0010"}
SALES_CODES={}
